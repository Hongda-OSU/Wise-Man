{
  "expo": {
    "name": "Wise Man",
    "slug": "wise-man",
    "scheme": "wiseman",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hongda.wiseman"
    },
    "android": {
      "package": "com.hongda.wiseman",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A2E28"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-screen.png",
          "resizeMode": "cover",
          "backgroundColor": "#1A2E28"
        }
      ],
      "expo-status-bar"
    ]
  }
}
